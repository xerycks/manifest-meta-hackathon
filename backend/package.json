{
  "name": "@manifest/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Manifest API — sources, schema manifests, and grounded query answers.",
  "engines": {
    "node": "^22.18.0 || ^24.11.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env.local dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/storage/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local src/storage/seed.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "google-auth-library": "^10.9.1",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3"
  }
}
