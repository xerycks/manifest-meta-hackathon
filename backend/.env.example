# Copy to .env.local and fill in local values. Never commit .env.local.

# HTTP server
HOST=127.0.0.1
PORT=3001

# Allowed browser origins, comma-separated. Empty disables cross-origin access.
CORS_ORIGINS=http://localhost:5173

# Application storage (PostgreSQL). Required from Cycle 03 onward.
# DATABASE_URL=postgres://USER@localhost:5432/manifest

# Encrypts saved source passwords (AES-256-GCM). Generate once and keep it
# stable: openssl rand -hex 32  (64 hex characters). Without it, source
# connection endpoints return 503; it is required in production when
# DATABASE_URL is set. Changing it makes saved passwords unreadable until
# they are re-entered.
# CONNECTION_ENCRYPTION_KEY=

# Synthetic demo source for local demos: `npm run db:demo-source` drops and
# rebuilds only the "shop" and "support" schemas in this database. Use a
# separate, disposable database — never application storage. Local only.
# DEMO_SOURCE_DATABASE_URL=postgres://USER@localhost:5432/manifest_demo_source

# Synthetic MongoDB demo data for local demos: `npm run db:demo-mongo` drops
# and rebuilds only the sessions, web_events, and product_reviews collections
# (and the product_ratings view) in the "manifest_demo" database of this
# server. Use a disposable local server. Local only.
# DEMO_MONGO_URL=mongodb://127.0.0.1:27017

# Integration tests read these from the shell, not from .env.local (see the
# README). They reset the PostgreSQL databases and create and drop
# manifest_it_* databases and a manifest_it_reader user on the MongoDB
# server, so point them only at throwaway ones. Tests whose URLs are unset
# are skipped.
# TEST_DATABASE_URL=postgres://USER@localhost:5432/manifest_test
# TEST_SOURCE_DATABASE_URL=postgres://USER@localhost:5432/manifest_source_test
# TEST_MONGO_URL=mongodb://127.0.0.1:27017

# Browser sessions. Generate once: openssl rand -hex 32.
# Required in production when DATABASE_URL is set; locally an ephemeral
# secret is used and sessions reset whenever the backend restarts.
# SESSION_SECRET=

# Public origin of the frontend (used for post-login redirects and cookies).
APP_ORIGIN=http://localhost:5173

# Google sign-in (identity only — no file access). Create a Web OAuth client
# in Google Cloud Console; never put the secret in frontend variables.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:3001/api/v1/auth/google/callback

# Local-only development sign-in (email form, no password). Ignored in production.
ALLOW_DEV_LOGIN=true

# Agent runtime (answers questions with tools and cited queries).
# AGENT_PROVIDER is "anthropic" (default; needs ANTHROPIC_API_KEY) or
# "scripted": a labeled demo model, "demo (synthetic)", that answers a few
# fixed questions about the synthetic demo source with real queries, for
# local walkthroughs without a key. "scripted" is refused in production.
# Without a usable provider the agent endpoints return 503 and everything
# else keeps working. Never commit the key; it is never logged.
# AGENT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-opus-5-5
# Model turns per question (1-50) and the time limit per question in ms.
# AGENT_MAX_STEPS=12
# AGENT_RUN_TIMEOUT_MS=300000
# How long a question waits for the user's reply to a clarification, in ms
# (the question's own time limit is paused meanwhile).
# AGENT_ANSWER_TIMEOUT_MS=1800000

# Scheduled routines: the shortest time a schedule may leave between runs, in
# minutes (1-1440), and how often each backend claims routines that are due,
# in ms. Lower the interval only for local demos and tests.
# ROUTINE_MIN_INTERVAL_MINUTES=5
# ROUTINE_POLL_INTERVAL_MS=15000
